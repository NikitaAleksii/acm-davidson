# Copy to .env and fill in.

# Database (SQLite file by default; see prisma/schema.prisma to switch to Postgres)
DATABASE_URL="file:./dev.db"

# Public URL of the site (used for Open Graph tags, .ics links, and emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Chapter contact address. Contact-form submissions are emailed here.
CHAPTER_EMAIL="acm@davidson.edu"

# SMTP settings for outgoing mail (contact form). If SMTP_HOST is empty,
# messages are still saved to the database and printed to the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ACM Davidson Website <no-reply@example.com>"

# Optional Cloudflare Turnstile CAPTCHA (free). If unset, the honeypot +
# rate limiting still protect the forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Used to seed the first admin account (npm run db:seed or npm run create-admin)
ADMIN_EMAIL="admin@davidson.edu"
ADMIN_NAME="ACM Admin"
ADMIN_PASSWORD="change-me-now"
