# Copy to .env and fill in. In production (Railway, Fly, Docker) set these as
# environment variables in the host's dashboard instead of a file.

# Database. Local dev: a SQLite file next to the schema.
# Production Docker: file:/data/acm.db (the /data volume). See DEPLOY.md.
DATABASE_URL="file:./dev.db"

# Where admin-uploaded images are stored. Production Docker: /data/uploads
UPLOAD_DIR="./uploads"

# Public URL of the site (used for Open Graph tags, .ics links, and emails).
# Production: https://your-domain.org (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Chapter contact address. Contact-form submissions are emailed here.
CHAPTER_EMAIL="acm@davidson.edu"

# SMTP settings for outgoing mail. REQUIRED in production: admin sign-in codes
# and password-reset links are emailed. Without SMTP_HOST, sign-in fails in
# production and codes are printed to the terminal in development.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ACM Davidson Website <no-reply@example.com>"

# Optional Cloudflare Turnstile CAPTCHA (free). If unset, the honeypot +
# rate limiting still protect the forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# First owner account. Used by `npm run db:seed` locally and created
# automatically on first start in production if no accounts exist yet.
# Sign-in codes are emailed to this address, so use a real inbox.
ADMIN_EMAIL="nialeksii@davidson.edu"
ADMIN_NAME="Nikita"
ADMIN_PASSWORD="change-me-now"
