{
  "name": "acm-davidson",
  "version": "1.0.0",
  "private": true,
  "description": "Website for the ACM Davidson College Student Chapter",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "sh scripts/start.sh",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
